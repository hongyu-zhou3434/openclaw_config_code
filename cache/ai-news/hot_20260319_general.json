core_desc": "504.15w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/aae39043ace375efe11167ddadb9a595", "type": "1", "type_desc": "新", "type_icon": "https://search-operate.cdn.bcebos.com/42e626c5469cc4cd3b91131bcfe53d44.png", "url": "https://www.baidu.com/s?wd=%E5%B0%8F%E7%B1%B3%E6%98%A5%E5%AD%A3%E6%96%B0%E5%93%81%E5%8F%91%E5%B8%83%E4%BC%9A&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 31, "title": "收评：沪指跌1.39%险守4000点", "desc": "3月19日，市场全天震荡调整，三大指数均跌超1%，沪指盘中一度跌破4000点关口。沪深两市成交额2.11万亿，较上一个交易日放量649亿。盘面上，市场热点题材弱势轮动，情绪降至冰点，全市场近5000只个股下跌。", "score": "4930835", "score_desc": "493.08w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/1e87d499360b70138c16b2d072f47a4d", "type": "3", "type_desc": "热", "type_icon": "https://search-operate.cdn.bcebos.com/54a1ed72d00cd07334860b0509489d8b.png", "url": "https://www.baidu.com/s?wd=%E6%94%B6%E8%AF%84%EF%BC%9A%E6%B2%AA%E6%8C%87%E8%B7%8C1.39%25%E9%99%A9%E5%AE%884000%E7%82%B9&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 32, "title": "现货黄金跌破4800美元关口", "desc": "19日，现货黄金持续下挫，跌破4800美元关口。截至发稿报4798.928美元/盎司，跌0.3%。", "score": "4853535", "score_desc": "485.35w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/ed922f476e366fe5ace18d33409b1bd3", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E7%8E%B0%E8%B4%A7%E9%BB%84%E9%87%91%E8%B7%8C%E7%A0%B44800%E7%BE%8E%E5%85%83%E5%85%B3%E5%8F%A3&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 33, "title": "一份CT报告错两次 涉事医院通报", "desc": "3月19日，南方医科大学南方医院通报“女子体检同一部位出具三份不同CT报告”事件情况。通报显示，涉事医生违反工作流程，未复核结果，出具错误报告。后又违反工作制度，私自修改诊断意见，导致诊断报告仍存在错误。医院已第一时间向患者致歉，并对相关责任人进行严肃处理。", "score": "4734188", "score_desc": "473.42w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/118e086630d904777b550d28eb5644ae", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E4%B8%80%E4%BB%BDCT%E6%8A%A5%E5%91%8A%E9%94%99%E4%B8%A4%E6%AC%A1+%E6%B6%89%E4%BA%8B%E5%8C%BB%E9%99%A2%E9%80%9A%E6%8A%A5&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 34, "title": "手机涨价 该“买”还是该“等”", "desc": "近期，国内手机市场迎来涨价潮。业内人士分析，从涨价特点来看，此次手机市场涨价呈现出明显的结构性差异，中低端手机涨幅多在300-500元，而高端新机涨幅可达1000-2000元。至少会延续至2027年，2026年将处于涨价周期的持续阶段。", "score": "4645477", "score_desc": "464.55w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/73fe0b1556da324f83c9a834b19f11c7", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E6%89%8B%E6%9C%BA%E6%B6%A8%E4%BB%B7+%E8%AF%A5%E2%80%9C%E4%B9%B0%E2%80%9D%E8%BF%98%E6%98%AF%E8%AF%A5%E2%80%9C%E7%AD%89%E2%80%9D&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 35, "title": "中方对以方说法感到震惊", "desc": "3月19日，外交部发言人林剑回应以色列授权击杀伊朗官员一事，明确表示中方对这一说法感到震惊，反对国际关系中使用武力，谴责杀害伊国家领导人的行径，敦促当事方停火止战，避免中东局势失控。", "score": "4570589", "score_desc": "457.06w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/d2d371089bc5edf11e364e61c8df6e98", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E6%96%B9%E5%AF%B9%E4%BB%A5%E6%96%B9%E8%AF%B4%E6%B3%95%E6%84%9F%E5%88%B0%E9%9C%87%E6%83%8A&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 36, "title": "生理期弄脏卧铺被要求洗净或赔180元", "desc": "2025年10月9日，当事人张女士在乘坐兰州铁路局K228次火车卧铺时因月经突然来临，车上买不到卫生巾，不慎弄脏床单，被工作人员要求自行清洗干净或赔偿180元。时隔大半年，她再次想起这件事并将这一经历分享到网上，呼吁火车上售卖卫生巾，吸引了大量关注。", "score": "4458550", "score_desc": "445.86w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/ff1398b037699fc0d6aad06d4eca2d50", "type": "1", "type_desc": "新", "type_icon": "https://search-operate.cdn.bcebos.com/42e626c5469cc4cd3b91131bcfe53d44.png", "url": "https://www.baidu.com/s?wd=%E7%94%9F%E7%90%86%E6%9C%9F%E5%BC%84%E8%84%8F%E5%8D%A7%E9%93%BA%E8%A2%AB%E8%A6%81%E6%B1%82%E6%B4%97%E5%87%80%E6%88%96%E8%B5%94180%E5%85%83&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 37, "title": "伊朗高官接连遇害如何影响战局走向", "desc": "近日，伊朗最高国家安全委员会秘书阿里·拉里贾尼和情报部长伊斯梅尔·哈提卜接连遇害。从伊朗方面传出的消息看，伊朗已为各种可能发生的情况做出准备。消息称，伊朗为所有关键政府官员和军事指挥官预先指定了3至7名不等的替代人选。", "score": "4351103", "score_desc": "435.11w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/b051b09f1759ae05d27ea51e40ec48f3", "type": "1", "type_desc": "新", "type_icon": "https://search-operate.cdn.bcebos.com/42e626c5469cc4cd3b91131bcfe53d44.png", "url": "https://www.baidu.com/s?wd=%E4%BC%8A%E6%9C%97%E9%AB%98%E5%AE%98%E6%8E%A5%E8%BF%9E%E9%81%87%E5%AE%B3%E5%A6%82%E4%BD%95%E5%BD%B1%E5%93%8D%E6%88%98%E5%B1%80%E8%B5%B0%E5%90%91&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 38, "title": "委内瑞拉击败美国夺冠 全国放假一天", "desc": "3月18日，2026世界棒球经典赛决赛，委内瑞拉3-2击败美国，队史首夺该项赛事冠军。委内瑞拉代总统德尔西-罗德里格斯在社交媒体上盛赞国家队的成就并宣布3月18日被定为“全国欢庆日”，除基本服务外全国放假一天。", "score": "4271983", "score_desc": "427.2w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/016ea9829ac6f734012ec4e3cdadef46", "type": "3", "type_desc": "热", "type_icon": "https://search-operate.cdn.bcebos.com/54a1ed72d00cd07334860b0509489d8b.png", "url": "https://www.baidu.com/s?wd=%E5%A7%94%E5%86%85%E7%91%9E%E6%8B%89%E5%87%BB%E8%B4%A5%E7%BE%8E%E5%9B%BD%E5%A4%BA%E5%86%A0+%E5%85%A8%E5%9B%BD%E6%94%BE%E5%81%87%E4%B8%80%E5%A4%A9&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 39, "title": "900克黄金被前男友偷走 3年后报警", "desc": "近日，浙江诸暨徐女士报警称，900克价值40多万元黄金被前男友蒋某盗走。二人通过微信相识，藏金位置仅告知对方，蒋某偷金变卖还网贷。徐女士心软私了未果，三年后报警，蒋某已被刑拘。", "score": "4187183", "score_desc": "418.72w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/4186f4e343325743c358cdadd29cb9a1", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=900%E5%85%8B%E9%BB%84%E9%87%91%E8%A2%AB%E5%89%8D%E7%94%B7%E5%8F%8B%E5%81%B7%E8%B5%B0+3%E5%B9%B4%E5%90%8E%E6%8A%A5%E8%AD%A6&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 40, "title": "外交部：美方应在台湾问题上谨言慎行", "desc": "3月19日，外交部发言人林剑回应记者就涉台相关问题的提问。林剑表示，美方应恪守一个中国原则和中美三个联合公报，在台湾问题上谨言慎行。同时美方的有关机构和人士应摒弃意识形态偏见和冷战零和思维，端正对华认知，停止炒作“中国威胁论”。", "score": "4088490", "score_desc": "408.85w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/7fb60830dbbed11c8d5afdb1be26f43a", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E5%A4%96%E4%BA%A4%E9%83%A8%EF%BC%9A%E7%BE%8E%E6%96%B9%E5%BA%94%E5%9C%A8%E5%8F%B0%E6%B9%BE%E9%97%AE%E9%A2%98%E4%B8%8A%E8%B0%A8%E8%A8%80%E6%85%8E%E8%A1%8C&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 41, "title": "跑腿小哥怕弄脏客户地板爬着进门", "desc": "", "score": "3967687", "score_desc": "396.77w", "cover": "https://fyb-1.cdn.bcebos.com/fyb/de6163834f53ca92c1273fff98ac9078.jpeg", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E8%B7%91%E8%85%BF%E5%B0%8F%E5%93%A5%E6%80%95%E5%BC%84%E8%84%8F%E5%AE%A2%E6%88%B7%E5%9C%B0%E6%9D%BF%E7%88%AC%E7%9D%80%E8%BF%9B%E9%97%A8&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 42, "title": "迪丽热巴平安回国后首次露面", "desc": "3月18日，VOGUE主编刘冲晒与迪丽热巴的合影，两人共进晚餐。刘冲称与热巴聊了很多，并称一切都好。这是迪丽热巴滞留迪拜回国后首次露面。", "score": "3887797", "score_desc": "388.78w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/092efe72642f3929242114b74ea40521", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E8%BF%AA%E4%B8%BD%E7%83%AD%E5%B7%B4%E5%B9%B3%E5%AE%89%E5%9B%9E%E5%9B%BD%E5%90%8E%E9%A6%96%E6%AC%A1%E9%9C%B2%E9%9D%A2&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 43, "title": "中方回应对菲律宾化肥出口问题", "desc": "3月19日，外交部发言人林剑回应“中方向菲方表示不会限制对菲律宾的化肥出口”等相关问题时表示，中东局势冲击了全球的能源安全，中方愿同东南亚国家加强协调配合，共同应对能源安全问题。“中国是化肥生产和消费的大国，也是国际化肥贸易的重要参与者。在满足国内需求的同时，部分化肥出口国际市场。”", "score": "3805164", "score_desc": "380.52w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/35d6786a12708224d0f48e82616343c8", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E6%96%B9%E5%9B%9E%E5%BA%94%E5%AF%B9%E8%8F%B2%E5%BE%8B%E5%AE%BE%E5%8C%96%E8%82%A5%E5%87%BA%E5%8F%A3%E9%97%AE%E9%A2%98&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 44, "title": "公司要求员工提前半小时到岗晨读", "desc": "近日，武侯区一公司被曝要求员工每天8点到岗晨读半小时，而正式上班时间为8点半，晨读内容多为管理经营类。网友认为此举属非工作时间加班，律师称公司需调整时间或支付加班费，避免法律风险。", "score": "3701142", "score_desc": "370.11w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/30c1a66deb6c1b649c623c80636d6824", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E5%85%AC%E5%8F%B8%E8%A6%81%E6%B1%82%E5%91%98%E5%B7%A5%E6%8F%90%E5%89%8D%E5%8D%8A%E5%B0%8F%E6%97%B6%E5%88%B0%E5%B2%97%E6%99%A8%E8%AF%BB&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 45, "title": "阿富汗与巴基斯坦宣布开斋节期间停火", "desc": "当地时间18日晚，阿富汗政府发言人穆贾希德在社交媒体发表声明说，开斋节期间阿富汗政府暂停针对巴基斯坦的军事行动。巴基斯坦方同日称，开斋节期间巴基斯坦将停止对阿富汗的袭击。据悉，阿富汗的开斋节从19日开始，巴基斯坦的开斋节预计从21日开始。根据传统，开斋节一般持续三天。", "score": "3607709", "score_desc": "360.77w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/d4e9163f9adcc7367f75fec31b885aaf", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E9%98%BF%E5%AF%8C%E6%B1%97%E4%B8%8E%E5%B7%B4%E5%9F%BA%E6%96%AF%E5%9D%A6%E5%AE%A3%E5%B8%83%E5%BC%80%E6%96%8B%E8%8A%82%E6%9C%9F%E9%97%B4%E5%81%9C%E7%81%AB&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 46, "title": "守护全国唯一解放军庙的阿婆去世了", "desc": "在福建省惠安县，有全国唯一一座纪念中国人民解放军烈士的庙宇，供奉着27尊解放军泥塑。据“中国退役军人”官方3月19日消息，发起筹建该庙的守庙人曾恨老人近日离世，享年92岁。", "score": "3528466", "score_desc": "352.85w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/295d6d54931479dab69e7ca6397ae9ad", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E5%AE%88%E6%8A%A4%E5%85%A8%E5%9B%BD%E5%94%AF%E4%B8%80%E8%A7%A3%E6%94%BE%E5%86%9B%E5%BA%99%E7%9A%84%E9%98%BF%E5%A9%86%E5%8E%BB%E4%B8%96%E4%BA%86&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 47, "title": "内蒙古一公司发生爆炸事故 2人失联", "desc": "2026年3月19日11时50分许，内蒙古自治区阿拉善盟利元科技有限公司硝化车间发生爆炸事故。经初步核实，事故已造成2人失联、3人轻伤，事故原因正在进一步调查。", "score": "3424819", "score_desc": "342.48w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/7dc7175b28ced3ae66ae3b76b60b8f75", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E5%86%85%E8%92%99%E5%8F%A4%E4%B8%80%E5%85%AC%E5%8F%B8%E5%8F%91%E7%94%9F%E7%88%86%E7%82%B8%E4%BA%8B%E6%95%85+2%E4%BA%BA%E5%A4%B1%E8%81%94&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 48, "title": "银行开始“劝退”炒金客", "desc": "提醒！近日多家银行收紧“积存金”业务，金价下跌也买不到，这项业务面临“手慢无”。面对银行“劝退”炒金客，有人想抄底却扑空，投资者称：有钱也买不进，这届投资者太难了。", "score": "3298999", "score_desc": "329.9w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/fea5426980f1f595b5de42a2e70e194e", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E9%93%B6%E8%A1%8C%E5%BC%80%E5%A7%8B%E2%80%9C%E5%8A%9D%E9%80%80%E2%80%9D%E7%82%92%E9%87%91%E5%AE%A2&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 49, "title": "周杰伦新专辑已开启预售 40元起售", "desc": "3月19日13点，周杰伦2026全新专辑《太阳之子》在全平台开启数字专辑预售。记者观察到，专辑预售1小时，QQ音乐平台售出超5万张，达到平台双白金唱片认证。该数字专辑预售价格从40元-128元不等，分多个档位。", "score": "3227551", "score_desc": "322.76w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8b4da397824c82e20b5ca41e268391ae", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E5%91%A8%E6%9D%B0%E4%BC%A6%E6%96%B0%E4%B8%93%E8%BE%91%E5%B7%B2%E5%BC%80%E5%90%AF%E9%A2%84%E5%94%AE+40%E5%85%83%E8%B5%B7%E5%94%AE&sa=fyb_news&rsv_dl=fyb_news"}, {"rank": 50, "title": "羽绒服到底能不能干洗", "desc": "清洗羽绒服有啥讲究？选择机洗还是手洗？羽绒服的水洗标通常会明确标识“不可干洗”。水洗时，有人直接将羽绒服扔进洗衣机，这样又会存在造成洗衣机“爆炸”的可能性。想要安全地洗羽绒服，一定要仔细阅读产品说明书和服装标签。", "score": "3140659", "score_desc": "314.07w", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8b61642a0f965a74a317bda17ce3060a", "type": "0", "type_desc": null, "type_icon": null, "url": "https://www.baidu.com/s?wd=%E7%BE%BD%E7%BB%92%E6%9C%8D%E5%88%B0%E5%BA%95%E8%83%BD%E4%B8%8D%E8%83%BD%E5%B9%B2%E6%B4%97&sa=fyb_news&rsv_dl=fyb_news"}]}