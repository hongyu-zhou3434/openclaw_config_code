    },
    "todo": {
      "enabled": true,
      "description": "待办管理 - 创建、更新、删除待办，设置提醒时间"
    },
    "document": {
      "enabled": true,
      "description": "文档管理 - 创建、编辑文档，智能表格管理"
    },
    "message": {
      "enabled": true,
      "description": "消息管理 - 发送消息，获取消息记录和会话列表"
    },
    "contact": {
      "enabled": true,
      "description": "通讯录管理 - 获取企业成员列表"
    }
  },
  "usage": {
    "quick_start": [
      "mcporter call wecom-schedule.create_schedule --args '{...}'",
      "mcporter call wecom-meeting.create_meeting --args '{...}'",
      "mcporter call wecom-todo.create_todo --args '{...}'",
      "mcporter call wecom-doc-new.create_doc --args '{...}'",
      "mcporter call wecom-msg.send_message --args '{...}'",
      "mcporter call wecom-contact.get_userlist --args '{}'"
    ]
  }
